class Solution {
    public boolean isAnagram(String s, String t) {
        if(s.length() != t.length()){
            return false;
        }
        ArrayList<Character> list = new ArrayList<>();

        for (char ch : t.toCharArray()) {
            list.add(ch);
        }

        for (char ch : s.toCharArray()) {

            if (list.contains(ch)) {
                list.remove((Character) ch);
            } else {
                return false;
            }
        }

        return true;
    }
}
